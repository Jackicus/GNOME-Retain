{
  "x-comment": [
    "The development build of this checkout (\"Retain (Development)\"), for GNOME Builder and CI.",
    "io.github.jackicus.Retain.json is Flathub's: the release build of a tag (FLATHUB.md)."
  ],
  "id": "io.github.jackicus.Retain.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "retain",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-run/speech-dispatcher:ro",
    "--talk-name=org.espeak.Speech.Provider",
    "--talk-name=ai.piper.Speech.Provider",
    "--share=network"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "/share/gir-1.0",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules": [
    "python3-speechd.json",
    "libspiel.json",
    {
      "name": "retain",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": [
        "-Dprofile=development"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
