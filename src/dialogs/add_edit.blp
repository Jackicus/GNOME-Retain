using Gtk 4.0;
using Adw 1;

// The note editor (dialogs/add_edit.py): Add Cards, or Edit Note. The field editors are
// made in code, one per field of the chosen note type, into fields_box.
template $RetainAddEditDialog: Adw.Dialog {
  title: _("Add Cards");
  content-width: 640;
  content-height: 720;
  follows-content-size: false;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
      }

      [end]
      Button primary_button {
        label: _("_Add");
        use-underline: true;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Box {
      orientation: vertical;

      Adw.Banner error_banner {
        revealed: false;
      }

      Adw.Banner duplicate_banner {
        title: _("A note with this front already exists");
        button-label: _("Show");
        revealed: false;
      }

      ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 640;
          tightening-threshold: 480;

          child: Box {
            orientation: vertical;
            spacing: 18;
            margin-top: 18;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            Adw.PreferencesGroup {
              Adw.ComboRow type_row {
                title: _("Type");
              }

              Adw.ComboRow deck_row {
                title: _("Deck");
              }
            }

            Box fields_box {
              orientation: vertical;
              spacing: 12;
            }

            Adw.PreferencesGroup {
              Adw.EntryRow tags_row {
                title: _("Tags");
              }
            }
          };
        };
      }
    };
  };
}
