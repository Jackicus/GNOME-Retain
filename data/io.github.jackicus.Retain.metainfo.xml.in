<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <name>Retain@NAME_SUFFIX@</name>
  <summary>Memorize anything with flashcards</summary>
  <description>
    <p>
      Write a question and an answer, or a sentence with a gap in it, and Retain shows the
      card again just before you would forget it. The FSRS algorithm plans each review, so a
      few minutes a day keeps thousands of facts.
    </p>
    <p>
      Retain opens Anki decks, including the ones other learners share, with their pictures,
      sounds, scheduling and progress, and exports decks Anki can open.
    </p>
    <ul>
      <li>Basic, reversed, type-in-the-answer, cloze and image occlusion cards</li>
      <li>Study by turning the card, typing the answer, or choosing it from options</li>
      <li>Your own note types, with a live preview of their card templates</li>
      <li>Cards read aloud in your system's voices</li>
      <li>Sync between computers through a folder kept in step by Syncthing or Nextcloud</li>
      <li>Card-mining apps such as Yomitan add cards through the AnkiConnect API</li>
      <li>Statistics, search with Anki's syntax, and undo for every change</li>
    </ul>
  </description>

  <developer id="io.github.jackicus">
    <name translate="no">Jack Tully</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/Jackicus/GNOME-Retain</url>
  <url type="bugtracker">https://github.com/Jackicus/GNOME-Retain/issues</url>
  <url type="help">https://github.com/Jackicus/GNOME-Retain/blob/main/docs/user-guide.md</url>
  <url type="vcs-browser">https://github.com/Jackicus/GNOME-Retain</url>
  <url type="contribute">https://github.com/Jackicus/GNOME-Retain#contributing</url>

  <translation type="gettext">retain</translation>

  <provides>
    <binary>retain</binary>
    <mediatype>application/x-anki-package</mediatype>
    <mediatype>application/x-anki-collection-package</mediatype>
  </provides>

  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <screenshots>
    <screenshot type="default" environment="gnome">
      <caption>A deck's overview: what is due today, and Study Now</caption>
      <image type="source" width="1000" height="700">https://raw.githubusercontent.com/Jackicus/GNOME-Retain/v0.2.0/data/screenshots/deck-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Reviewing a card, the answer shown and the four grades below</caption>
      <image type="source" width="1000" height="700">https://raw.githubusercontent.com/Jackicus/GNOME-Retain/v0.2.0/data/screenshots/review-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Every card of a deck in the browser, found with Anki's search syntax</caption>
      <image type="source" width="1000" height="700">https://raw.githubusercontent.com/Jackicus/GNOME-Retain/v0.2.0/data/screenshots/browse-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Statistics in the dark style: the year's reviews and what is due ahead</caption>
      <image type="source" width="1000" height="700">https://raw.githubusercontent.com/Jackicus/GNOME-Retain/v0.2.0/data/screenshots/stats-dark.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-10-08">
      <description>
        <p>The first release.</p>
        <ul>
          <li>Decks, note types and cards: basic, reversed, type-in, cloze and image occlusion</li>
          <li>FSRS scheduling with a desired-retention slider and an optimizer</li>
          <li>Anki packages (.apkg, .colpkg) in and out, and CSV/TSV import</li>
          <li>Search with Anki's syntax, statistics, and undo for every change</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
